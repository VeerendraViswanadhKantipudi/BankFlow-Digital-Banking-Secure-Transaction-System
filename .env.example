# Flask Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=bankflow-production-secret-key-super-secure
JWT_SECRET_KEY=bankflow-jwt-super-secret-key-production
JWT_EXPIRATION_HOURS=24

# Database Configuration (MySQL InnoDB is required - SQLite is strictly prohibited)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/bankflow
TEST_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/bankflow_test

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
